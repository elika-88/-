OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_API_FORMAT=responses
# Generate these locally using npm run admin:setup
ADMIN_PASSWORD=
ADMIN_ENCRYPTION_KEY=
