# Server-only API configuration. Never commit real credentials.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_API_FORMAT=chat_completions

# Run npm run admin:setup locally to create installation-specific credentials.
ADMIN_PASSWORD=
ADMIN_ENCRYPTION_KEY=
ADMIN_DATABASE_PATH=.data/admin.sqlite

# Vercel requires a persistent libSQL/Turso database. Set both variables there.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
