# Server-only API configuration. Never commit real credentials.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_API_FORMAT=chat_completions

# Run npm run admin:setup locally to create installation-specific credentials.
ADMIN_PASSWORD=
ADMIN_ENCRYPTION_KEY=
ADMIN_DATABASE_PATH=.data/admin.sqlite

# Required for new account registration and email verification.
# APP_BASE_URL must be your site's public origin (HTTPS in production).
APP_BASE_URL=http://127.0.0.1:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Vercel requires a persistent libSQL/Turso database. Set both variables there.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Background generation: enable after configuring and syncing Inngest.
LUMINA_BACKGROUND_GENERATION=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local development only, with the Inngest Dev Server running:
# INNGEST_DEV=1

# PayPal subscriptions (Lumina Basic / Pro). Keep real values in .env.local only.
# PAYPAL_ENV=live            # live or sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# Filled in by: npm run paypal:setup (Basic $9.90/month or $95/year; Pro $12.90/month or $124/year)
# PAYPAL_CURRENCY=USD
# PAYPAL_PLAN_BASIC_MONTHLY_ID=
# PAYPAL_PRICE_BASIC_MONTHLY=9.90
# PAYPAL_PLAN_BASIC_YEARLY_ID=
# PAYPAL_PRICE_BASIC_YEARLY=95.00
# PAYPAL_PLAN_PRO_MONTHLY_ID=
# PAYPAL_PRICE_PRO_MONTHLY=12.90
# PAYPAL_PLAN_PRO_YEARLY_ID=
# PAYPAL_PRICE_PRO_YEARLY=124.00
# PAYPAL_WEBHOOK_ID=

# RevenueCat Web Billing. Create a Web Billing configuration in RevenueCat and
# connect Stripe, Paddle, or RevenueCat Billing before enabling this channel in
# /admin. Never expose the secret or webhook token to the browser.
# REVENUECAT_ENV=production       # production or sandbox
# REVENUECAT_PUBLIC_API_KEY=rcb_...
# REVENUECAT_SECRET_API_KEY=sk_...
# REVENUECAT_WEBHOOK_AUTH_TOKEN=  # at least 32 random characters
# REVENUECAT_OFFERING_ID=default
# REVENUECAT_ENTITLEMENT_BASIC=basic
# REVENUECAT_ENTITLEMENT_PRO=pro
# REVENUECAT_PRODUCT_BASIC_MONTHLY=basic_monthly
# REVENUECAT_PRODUCT_BASIC_YEARLY=basic_yearly
# REVENUECAT_PRODUCT_PRO_MONTHLY=pro_monthly
# REVENUECAT_PRODUCT_PRO_YEARLY=pro_yearly
